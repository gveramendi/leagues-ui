#!/bin/bash

# Hook para validar formato de Conventional Commits
# Formato: <tipo>(<scope>): <descripción>

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Colores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Regex para validar formato
# Tipos permitidos: feat, fix, docs, style, refactor, test, chore
pattern="^(feat|fix|docs|style|refactor|test|chore)(\([a-z0-9-]+\))?: .{1,68}$"

# Permitir commits de merge
if [[ $commit_msg =~ ^Merge ]]; then
    exit 0
fi

# Validar formato
if ! [[ $commit_msg =~ $pattern ]]; then
    echo -e "${RED}ERROR: Formato de commit inválido${NC}"
    echo ""
    echo -e "${YELLOW}Formato esperado:${NC}"
    echo "  <tipo>(<scope>): <descripción>"
    echo ""
    echo -e "${YELLOW}Tipos permitidos:${NC}"
    echo "  feat     - Nueva funcionalidad"
    echo "  fix      - Corrección de bug"
    echo "  docs     - Documentación"
    echo "  style    - Formato (no afecta lógica)"
    echo "  refactor - Refactorización"
    echo "  test     - Tests"
    echo "  chore    - Mantenimiento"
    echo ""
    echo -e "${YELLOW}Ejemplos válidos:${NC}"
    echo "  feat(users): agregar endpoint de listado"
    echo "  fix(auth): corregir validación de token"
    echo "  test(products): agregar tests unitarios"
    echo ""
    echo -e "${YELLOW}Tu mensaje:${NC}"
    echo "  $commit_msg"
    echo ""
    exit 1
fi

# Validar longitud
if [ ${#commit_msg} -gt 72 ]; then
    echo -e "${RED}ERROR: Mensaje muy largo (${#commit_msg} caracteres)${NC}"
    echo "Máximo permitido: 72 caracteres"
    exit 1
fi

# Validar que no termine con punto
if [[ $commit_msg =~ \.$ ]]; then
    echo -e "${RED}ERROR: El mensaje no debe terminar con punto${NC}"
    exit 1
fi

echo -e "${GREEN}✓ Formato de commit válido${NC}"
exit 0
